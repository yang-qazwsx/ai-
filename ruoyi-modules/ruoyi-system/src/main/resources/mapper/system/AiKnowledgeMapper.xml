<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiKnowledgeMapper">

    <!-- 使用全限定类名，避免依赖 Nacos 中的 type-aliases-package 配置 -->
    <resultMap type="com.ruoyi.system.domain.AiKnowledge" id="AiKnowledgeResult">
        <id     property="id"         column="id"          />
        <result property="question"   column="question"    />
        <result property="answer"     column="answer"      />
        <result property="category"   column="category"    />
        <result property="hitCount"   column="hit_count"   />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectAiKnowledgeVo">
        select id, question, answer, category, hit_count, create_time, update_time
        from ai_knowledge
    </sql>

    <!-- 按主键查询 -->
    <select id="selectAiKnowledgeById" resultMap="AiKnowledgeResult">
        <include refid="selectAiKnowledgeVo"/>
        where id = #{id}
    </select>

    <!-- 按分类/问题条件查询；Service 层调用 startPage() 即由 PageHelper 完成分页 -->
    <select id="selectPageByCategory" parameterType="com.ruoyi.system.domain.AiKnowledge" resultMap="AiKnowledgeResult">
        <include refid="selectAiKnowledgeVo"/>
        <where>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="question != null and question != ''">
                AND question like concat('%', #{question}, '%')
            </if>
            <if test="answer != null and answer != ''">
                AND answer like concat('%', #{answer}, '%')
            </if>
        </where>
        order by hit_count desc, id desc
    </select>

    <!-- 关键词模糊检索：问题或答案命中，热门条目优先。
         表上有 FULLTEXT ft_question(question)，但默认分词器对中文短句召回不稳定，
         这里用 LIKE 保证中文问答的召回率；数据量上来后可再改 MATCH ... AGAINST -->
    <select id="selectByKeyword" resultMap="AiKnowledgeResult">
        <include refid="selectAiKnowledgeVo"/>
        <where>
            <if test="keyword != null and keyword != ''">
                AND (question like concat('%', #{keyword}, '%')
                     or answer like concat('%', #{keyword}, '%'))
            </if>
        </where>
        order by hit_count desc, id desc
    </select>

    <!-- 批量增加命中次数：每次命中 +1；空集合时退化成不更新任何行，避免 in () 语法错误 -->
    <update id="batchUpdateHitCount">
        update ai_knowledge
        set hit_count = coalesce(hit_count, 0) + 1,
            update_time = sysdate()
        where
        <choose>
            <when test="ids != null and ids.size() > 0">
                id in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
    </update>

    <!-- 新增：question / answer / category 都是非空列且 category 无默认值，必须显式传入；
         create_time、update_time 由数据库默认值与 ON UPDATE CURRENT_TIMESTAMP 维护 -->
    <insert id="insertAiKnowledge" parameterType="com.ruoyi.system.domain.AiKnowledge"
            useGeneratedKeys="true" keyProperty="id">
        insert into ai_knowledge
        <trim prefix="(" suffix=")" suffixOverrides=",">
            question, answer, category,
            <if test="hitCount != null">hit_count,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{question}, #{answer}, #{category},
            <if test="hitCount != null">#{hitCount},</if>
        </trim>
    </insert>

    <!-- 按主键修改，只更新传入的非空字段 -->
    <update id="updateAiKnowledge" parameterType="com.ruoyi.system.domain.AiKnowledge">
        update ai_knowledge
        <set>
            <if test="question != null and question != ''">question = #{question}, </if>
            <if test="answer != null">answer = #{answer}, </if>
            <if test="category != null and category != ''">category = #{category}, </if>
            <if test="hitCount != null">hit_count = #{hitCount}, </if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <!-- 批量删除；空数组时退化成不删除任何行 -->
    <delete id="deleteAiKnowledgeByIds">
        delete from ai_knowledge
        where
        <choose>
            <when test="ids != null and ids.length > 0">
                id in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
    </delete>

</mapper>
