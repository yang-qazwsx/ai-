<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizBookMapper">

    <resultMap type="com.ruoyi.system.domain.BizBook" id="BizBookResult">
        <id     property="bookId"      column="book_id"      />
        <result property="isbn"        column="isbn"         />
        <result property="title"       column="title"        />
        <result property="author"      column="author"       />
        <result property="publisher"   column="publisher"    />
        <result property="price"       column="price"        />
        <result property="stock"       column="stock"        />
        <result property="category"    column="category"     />
        <result property="status"      column="status"       />
        <result property="description" column="description"  />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="selectBizBookVo">
        select book_id, isbn, title, author, publisher, price, stock, category,
               status, description, create_time, update_time
        from biz_book
    </sql>

    <select id="selectBizBookById" resultMap="BizBookResult">
        <include refid="selectBizBookVo"/>
        where book_id = #{bookId}
    </select>

    <select id="selectBizBookList" parameterType="com.ruoyi.system.domain.BizBook" resultMap="BizBookResult">
        <include refid="selectBizBookVo"/>
        <where>
            <if test="isbn != null and isbn != ''">AND isbn like concat('%', #{isbn}, '%')</if>
            <if test="title != null and title != ''">AND title like concat('%', #{title}, '%')</if>
            <if test="author != null and author != ''">AND author like concat('%', #{author}, '%')</if>
            <if test="category != null and category != ''">AND category = #{category}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by book_id desc
    </select>

    <!-- status: 1=上架、0=下架（与前端一致），推荐只取上架且有库存的书 -->
    <select id="selectRecommendCandidates" resultMap="BizBookResult">
        <include refid="selectBizBookVo"/>
        <where>
            status = '1'
            and stock &gt; 0
            <if test="maxPrice != null">AND price &lt;= #{maxPrice}</if>
            <if test="category != null and category != ''">AND category = #{category}</if>
        </where>
        order by stock desc, price asc
        limit #{limit}
    </select>

    <!-- 检索类查询统一只回传作答需要的字段：description 只参与匹配，不回传给 JVM -->
    <sql id="bookIndexColumns">
        book_id, title, author, price, stock, category, status
    </sql>

    <!-- 全文索引检索：依赖 ft_book_search(title,category,description) WITH PARSER ngram，
         列顺序必须与索引定义完全一致，否则报 "Can't find FULLTEXT index matching the column list"。
         排序用相关度优先、库存次之。 -->
    <select id="searchBookByFulltext" resultMap="BizBookResult">
        select <include refid="bookIndexColumns"/>
        from biz_book
        where MATCH(title, category, description) AGAINST (#{keyword} IN BOOLEAN MODE)
        order by MATCH(title, category, description) AGAINST (#{keyword} IN BOOLEAN MODE) desc, stock desc
        limit #{limit}
    </select>

    <!-- LIKE 兜底：中文 ngram 对中英混排中的英文词会漏检（"Java 编程思想" 搜不到 "Java"），
         全文检索为空时用它补一次。% 和 _ 由调用方清洗，避免通配符注入。 -->
    <select id="searchBookByLike" resultMap="BizBookResult">
        select <include refid="bookIndexColumns"/>
        from biz_book
        where title like concat('%', #{keyword}, '%')
           or category like concat('%', #{keyword}, '%')
           or description like concat('%', #{keyword}, '%')
        order by stock desc
        limit #{limit}
    </select>

    <select id="selectOnSaleBooks" resultMap="BizBookResult">
        select <include refid="bookIndexColumns"/>
        from biz_book
        where status = '1' and stock &gt; 0
        order by stock desc
        limit #{limit}
    </select>

    <!-- ES 召回后回查：带上 description 等完整字段，价格库存以 MySQL 为准 -->
    <select id="selectBooksByIds" resultMap="BizBookResult">
        <include refid="selectBizBookVo"/>
        where book_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <!-- 只取书名：用于校验模型回答里是否出现"库里没有的书" -->
    <select id="selectBookTitles" resultType="java.lang.String">
        select title from biz_book where title is not null and title != ''
    </select>

    <!-- 去重分类：识别只提品类不提"书"字的问法（"我喜欢看科幻"） -->
    <select id="selectBookCategories" resultType="java.lang.String">
        select distinct category from biz_book
        where category is not null and category != ''
    </select>

    <insert id="insertBizBook" parameterType="com.ruoyi.system.domain.BizBook"
            useGeneratedKeys="true" keyProperty="bookId">
        insert into biz_book
        <trim prefix="(" suffix=")" suffixOverrides=",">
            title,
            <if test="isbn != null and isbn != ''">isbn,</if>
            <if test="author != null and author != ''">author,</if>
            <if test="publisher != null and publisher != ''">publisher,</if>
            <if test="price != null">price,</if>
            <if test="stock != null">stock,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="description != null and description != ''">description,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{title},
            <if test="isbn != null and isbn != ''">#{isbn},</if>
            <if test="author != null and author != ''">#{author},</if>
            <if test="publisher != null and publisher != ''">#{publisher},</if>
            <if test="price != null">#{price},</if>
            <if test="stock != null">#{stock},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="description != null and description != ''">#{description},</if>
        </trim>
    </insert>

    <update id="updateBizBook" parameterType="com.ruoyi.system.domain.BizBook">
        update biz_book
        <set>
            <if test="isbn != null">isbn = #{isbn}, </if>
            <if test="title != null and title != ''">title = #{title}, </if>
            <if test="author != null">author = #{author}, </if>
            <if test="publisher != null">publisher = #{publisher}, </if>
            <if test="price != null">price = #{price}, </if>
            <if test="stock != null">stock = #{stock}, </if>
            <if test="category != null">category = #{category}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
            <if test="description != null">description = #{description}, </if>
            book_id = book_id
        </set>
        where book_id = #{bookId}
    </update>

    <delete id="deleteBizBookByIds">
        delete from biz_book
        where
        <choose>
            <when test="ids != null and ids.length > 0">
                book_id in
                <foreach item="id" collection="ids" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>1 = 0</otherwise>
        </choose>
    </delete>

</mapper>
